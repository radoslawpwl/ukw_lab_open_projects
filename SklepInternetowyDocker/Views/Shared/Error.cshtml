@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<h1 class="text-danger">@T["Błąd"]</h1>
<h2 class="h4">@T["Nie udało się przetworzyć żądania. Spróbuj ponownie później."]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["Identyfikator żądania"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Products" asp-action="Index">@T["Wróć do usług"]</a>
