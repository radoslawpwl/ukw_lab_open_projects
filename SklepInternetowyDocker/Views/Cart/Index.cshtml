@model IReadOnlyCollection<SklepInternetowyDocker.Models.CartItem>

@{
    ViewData["Title"] = "Koszyk usług";
    var total = Model.Sum(item => item.Total);
    var currency = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");
}

<p class="eyebrow">RP-bit / WYBRANE PAKIETY</p>
<h1>Koszyk usług</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-4">Nie masz jeszcze wybranych usług.</p>
    <a class="btn btn-primary"
       asp-controller="Products"
       asp-action="Index">
        Przeglądaj usługi
    </a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Usługa</th>
                <th scope="col">Cena netto</th>
                <th scope="col">Pakiety</th>
                <th scope="col">Razem netto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("N2", currency) zł</td>
                    <td>@item.Quantity</td>
                    <td>@item.Total.ToString("N2", currency) zł</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden"
                                   name="productId"
                                   value="@item.ProductId">
                            <button class="btn btn-sm btn-danger" type="submit">
                                Usuń
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Suma netto</th>
                <th>@total.ToString("N2", currency) zł</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="service-detail-actions">
        <a class="btn btn-primary" asp-controller="Contact" asp-action="Index" asp-route-fromCart="true">Zapytaj o realizację</a>
        <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">Dodaj kolejną usługę</a>
        <form asp-action="Clear" method="post">
            <button class="btn btn-outline-danger" type="submit">Wyczyść koszyk</button>
        </form>
    </div>
    <p class="pricing-note">
        Koszyk służy do przygotowania zapytania, nie stanowi złożenia zamówienia ani płatności.
        Suma jest orientacyjna i nie zawiera ewentualnego VAT. Zakres, termin i ostateczna wycena wymagają potwierdzenia.
    </p>
}