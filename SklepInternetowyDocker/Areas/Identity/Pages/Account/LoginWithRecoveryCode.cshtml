@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginWithRecoveryCodeModel
@{ ViewData["Title"] = "Kod odzyskiwania"; }
<h1>@T["Kod odzyskiwania"]</h1>
<form method="post" class="col-lg-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.RecoveryCode" class="form-label">@T["Kod odzyskiwania"]</label>
        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@T["Zaloguj się"]</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }