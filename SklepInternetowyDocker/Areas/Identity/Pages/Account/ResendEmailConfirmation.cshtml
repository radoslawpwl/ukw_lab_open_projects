@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResendEmailConfirmationModel
@{ ViewData["Title"] = "Wyślij ponownie potwierdzenie adresu e-mail"; }
<h1 class="h3">@T["Wyślij ponownie potwierdzenie adresu e-mail"]</h1>
<form method="post" class="col-lg-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@T["Adres e-mail"]</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@T["Wyślij potwierdzenie"]</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }