@page
@{
    ViewData["Title"] = "Potwierdź adres e-mail";
}

<div class="row justify-content-center">
    <section class="col-md-8 col-lg-6">
        <p class="service-category">RP-bit / @T["Konto klienta"]</p>
        <h1 class="mb-4">@T["Potwierdź adres e-mail"]</h1>
        <p>@T["Jeśli rejestracja się powiodła, otrzymasz wiadomość z odnośnikiem do potwierdzenia konta. Sprawdź skrzynkę pocztową."]</p>
        <p class="mt-4"><a asp-page="./Login">@T["Przejdź do logowania"]</a></p>
    </section>
</div>