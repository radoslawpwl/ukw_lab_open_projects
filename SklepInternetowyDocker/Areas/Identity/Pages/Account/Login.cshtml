@page
@model SklepInternetowyDocker.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Zaloguj się";
}

<div class="row justify-content-center">
    <section class="col-md-8 col-lg-6">
        <p class="service-category">RP-bit / Konto klienta</p>
        <h1 class="mb-4">Zaloguj się</h1>

        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" required />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-primary w-100">Zaloguj się</button>
        </form>

        <div class="d-flex flex-column align-items-start gap-2 mt-4">
            <a asp-page="./ForgotPassword">Nie pamiętasz hasła?</a>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Nie masz konta? Zarejestruj się</a>
            <a asp-page="./ResendEmailConfirmation">Wyślij ponownie potwierdzenie adresu e-mail</a>
        </div>

        @if (Model.ExternalLogins.Count > 0)
        {
            <h2 class="h5 mt-4">Zaloguj się przez</h2>
            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex flex-wrap gap-2">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">@provider.DisplayName</button>
                }
            </form>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}